NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://root:password@localhost:3306/expense_tracker?connection_limit=10"

JWT_ACCESS_SECRET="your_jwt_access_secret_change_in_production"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

DEFAULT_CURRENCY="BDT"
DEFAULT_TIMEZONE="Asia/Dhaka"

GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
UPLOAD_DIR="./uploads"
LOG_LEVEL="info"
